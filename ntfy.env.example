# Copy to ntfy.env locally or /etc/carleton-watch.env on the Pi.
# Subscribe to the same server and topic in the ntfy iPhone app.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=replace-with-your-own-long-random-topic
# Optional: leave empty for an anonymous topic.
NTFY_TOKEN=
# Comma-separated CRNs for the term in config.toml. Add or remove entries here.
CRNS=32301,32309,32315,32338,33780,33788,34130,34139
