# Copy to postmark.env locally or /etc/carleton-watch.env on the server.
# Set file permissions to 600. Do not commit the real file or share the token.
# Use a Live server, a Server API token, and a verified sender address or domain.
POSTMARK_SERVER_TOKEN=replace-with-your-server-api-token
POSTMARK_FROM_EMAIL=alerts@your-domain.com
ALERT_EMAIL=your-account@gmail.com
